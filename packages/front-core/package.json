{
  "name": "@obsidion/front-core",
  "version": "0.1.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -r src/assets dist/assets && tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && eslint",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "test": "vitest run",
    "test:anvil": "vitest run -c vitest.anvil.config.ts",
    "bench:sipa": "vitest run -c vitest.bench.config.ts",
    "test:testnet:tee-smoke": "vitest run -c vitest.testnet.config.ts",
    "test:e2e:reorg": "vitest run -c vitest.e2e.config.ts test/e2e/reorgSandbox.e2e.ts",
    "test:e2e:requests": "vitest run -c vitest.e2e.config.ts test/e2e/requestMetaFulfillment.e2e.ts",
    "test:e2e:transfer-scan": "vitest run -c vitest.e2e.config.ts test/e2e/webWalletTransferScan.e2e.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "v6.0.0",
    "@aztec-labs/constants": "v6.0.0",
    "@aztec-labs/entrypoints": "v6.0.0",
    "@aztec-labs/ethereum": "v6.0.0",
    "@aztec-labs/foundation": "v6.0.0",
    "@aztec-labs/kv-store": "v6.0.0",
    "@aztec-foundation/l1-artifacts": "v6.0.0",
    "@aztec-labs/pxe": "v6.0.0",
    "@aztec-labs/stdlib": "v6.0.0",
    "@aztec-labs/simulator": "v6.0.0",
    "@noble/curves": "^1.7.0",
    "@obsidion/core": "workspace:*",
    "@obsidion/proving-progress": "workspace:*",
    "@obsidion/sdk": "workspace:*",
    "@oxide/experiments": "workspace:*",
    "@oxide/l1-contracts": "workspace:*",
    "@react-oauth/google": "^0.12.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash-es": "^4.17.12",
    "cbor-x": "^1.6.4",
    "classnames": "^2.5.1",
    "eventemitter3": "^5.0.1",
    "lodash-es": "^4.17.21",
    "ox": "^0.6.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "ts-essentials": "^10.0.2",
    "uuid": "^11.1.0",
    "viem": "2.57.1",
    "zod": "^4.4.3",
    "@oxide/oxide-lib": "workspace:*"
  },
  "devDependencies": {
    "@obsidion/generation-v5": "workspace:*",
    "@obsidion/lint-config": "workspace:*",
    "@oxide/oxide-client": "workspace:*",
    "@oxide/tee-enclave": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^18.7.23",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitest/coverage-v8": "^2.1.5",
    "buffer": "^6.0.3",
    "eslint": "^9.36.0",
    "jsdom": "^25.0.1",
    "prettier": "^2.8.8",
    "prettier-plugin-packagejson": "^2.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
